# Copy to .env and fill in. Never commit .env.

# Postgres. On Homebrew the user is your macOS username and there is no password.
DATABASE_URL=postgresql://<mac-username>@localhost:5432/movies
# Separate database for integration tests. Tests refuse to run without it.
TEST_DATABASE_URL=postgresql://<mac-username>@localhost:5432/movies_test

REDIS_URL=redis://localhost:6379

# Port the API listens on. The Vite dev server proxies /api to it.
PORT=3000
# Origin of the web app, used for CORS.
WEB_ORIGIN=http://localhost:5173

# Optional. How long /api/health waits for each service, in milliseconds.
# HEALTH_CHECK_TIMEOUT_MS=2000

# Optional. Settings for `pnpm ingest`.
# Folder holding movies.parquet and movie_tags.parquet. Default: data/clean in the repo.
# DATA_DIR=
# Movies written per transaction.
# INGEST_BATCH_SIZE=500
# The weighted rating's minimum votes (m) is this percentile of vote_count, 0 to 1.
# RATING_MIN_VOTES_PERCENTILE=0.5

# Optional. Search ranking weights (see docs/ARCHITECTURE.md).
# SEARCH_WEIGHT_TEXT=1
# SEARCH_WEIGHT_TAGS=1
# SEARCH_WEIGHT_RATING=1
# Optional. Poster URLs are this prefix plus the movie's poster path.
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w342

# Gemini. Needed for `pnpm embed` and, from Phase 5, for search by meaning.
# Create a key at https://aistudio.google.com/apikey. Never commit it.
GEMINI_API_KEY=
# Optional. Models and settings (D-040).
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must match the vector size of the movie_embeddings table.
# EMBEDDING_DIMENSIONS=768
# Retries after a 429 or 5xx, with exponential backoff.
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_MS=1000
# LLM_RETRY_MAX_MS=30000

# Optional. Retries while a user is waiting: few and quick, then fall back.
# LLM_ONLINE_MAX_RETRIES=1
# LLM_ONLINE_RETRY_BASE_MS=200
# LLM_ONLINE_RETRY_MAX_MS=1000

# Optional. The parse step: a small, fast model with the least thinking (D-045).
# GEMINI_PARSE_MODEL=gemini-3.5-flash-lite
# GEMINI_PARSE_THINKING_LEVEL=minimal
# PARSE_TIMEOUT_MS=4000
# PARSE_MAX_OUTPUT_TOKENS=500
# How long a parsed request stays in Redis (default 7 days).
# PARSE_CACHE_TTL_SECONDS=604800

# Optional. POST /api/recommend (see docs/ARCHITECTURE.md).
# How many nearest movies are taken from the vector index before re-scoring.
# RECOMMEND_CANDIDATES=30
# RECOMMEND_WEIGHT_SIMILARITY=1
# RECOMMEND_WEIGHT_RATING=0.2
# How much a wanted tag lifts a movie that has it.
# RECOMMEND_WEIGHT_TAGS=0.1
# "like Inception": how far the search moves toward the named film, 0 to 1.
# RECOMMEND_REFERENCE_WEIGHT=0.5
# How close a typed title must be to a real one to count as that film, 0 to 1.
# REFERENCE_TITLE_MIN_SIMILARITY=0.55
# EMBED_QUERY_TIMEOUT_MS=4000
# How long a request's embedding stays in Redis (default 7 days).
# QUERY_EMBEDDING_TTL_SECONDS=604800

# Optional. The embeddings job (`pnpm embed`). One batch is one API request of
# about 3,500 tokens; the free tier allows about 30,000 tokens a minute and
# 1,000 texts a day.
# EMBED_BATCH_SIZE=20
# EMBED_REQUESTS_PER_MINUTE=7
# EMBED_TIMEOUT_MS=60000
# EMBED_JOB_ATTEMPTS=3
# Where `pnpm embed:export` writes and `pnpm embed:import` reads.
# EXPORT_DIR=
