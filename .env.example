# Copy to .env and fill in. Never commit .env.

# Postgres. On Homebrew the user is your macOS username and there is no password.
DATABASE_URL=postgresql://<mac-username>@localhost:5432/movies
# Separate database for integration tests. Tests refuse to run without it.
TEST_DATABASE_URL=postgresql://<mac-username>@localhost:5432/movies_test

REDIS_URL=redis://localhost:6379

# Port the API listens on. The Vite dev server proxies /api to it.
PORT=3000
# Origin of the web app, used for CORS.
WEB_ORIGIN=http://localhost:5173

# Optional. How long /api/health waits for each service, in milliseconds.
# HEALTH_CHECK_TIMEOUT_MS=2000

# Optional. Settings for `pnpm ingest`.
# Folder holding movies.parquet and movie_tags.parquet. Default: data/clean in the repo.
# DATA_DIR=
# Movies written per transaction.
# INGEST_BATCH_SIZE=500
# The weighted rating's minimum votes (m) is this percentile of vote_count, 0 to 1.
# RATING_MIN_VOTES_PERCENTILE=0.5
